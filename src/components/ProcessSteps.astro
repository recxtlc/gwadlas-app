---
import services from '../content/services.json';
---

<ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
  {services.process.map((s) => (
    <li class="grid grid-cols-[32px_1fr] gap-2 sm:flex sm:flex-col sm:gap-2.5">
      <span class="text-[13px] text-accent">{s.n}</span>
      <div class="flex flex-col gap-1 sm:gap-2.5">
        <span class="text-[17px] sm:text-xl">{s.title}</span>
        <span class="text-[13px] text-neutral-400 text-pretty">{s.body}</span>
      </div>
    </li>
  ))}
</ol>
