---
// The content editor (Decap CMS) at /admin. Its settings are in public/admin/config.yml.
// This is an Astro page rather than a file in public/ so /admin and /admin/ both work,
// locally and on GitHub Pages under any base path.
const configUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/admin/config.yml`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Gwadlas · Content editor</title>
    <link href={configUrl} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>
