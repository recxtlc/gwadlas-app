---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import LabelledSection from '../components/LabelledSection.astro';
import StatsBand from '../components/StatsBand.astro';
import CtaPanel from '../components/CtaPanel.astro';
import about from '../content/about.json';
---

<BaseLayout title="About" description={about.story[0]}>
  <section class="wrap pt-10 sm:pt-16">
    <span class="kicker">{about.title}</span>
    <h1 class="mt-4 mb-0 max-w-[900px] text-[40px] leading-[1.02] tracking-[-0.03em] sm:text-[56px] lg:text-[72px] lg:leading-none text-balance">
      {about.lead}
    </h1>
  </section>

  <section class="wrap grid gap-10 pt-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14 lg:pt-16">
    <Photo name={about.image.photo} alt={about.image.alt} class="h-[420px] lg:h-[620px]" eager />
    <div class="flex flex-col gap-5 self-end text-base text-neutral-300 text-pretty">
      {about.story.map((para) => <p class="m-0">{para}</p>)}
    </div>
  </section>

  <section class="wrap grid gap-6 pt-20 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-end lg:gap-14 lg:pt-24">
    <blockquote class="m-0 text-2xl leading-[1.25] tracking-[-0.015em] sm:text-[34px] text-pretty">
      “{about.quote.text}”
    </blockquote>
    <span class="text-[13px] text-neutral-400">{about.quote.attribution}</span>
  </section>

  <LabelledSection label={about.peopleLabel} class="pt-20 lg:pt-24">
    <div class="grid gap-8 sm:grid-cols-3 sm:gap-4">
      {about.people.map((p) => (
        <div class="flex flex-col gap-2.5">
          <Photo name={p.photo} alt={`Portrait for ${p.name}`} class="h-[320px] sm:h-[300px] lg:h-[380px]" />
          <span class="text-[15px]">{p.name}</span>
          <span class="kicker -mt-1">{p.role}</span>
          <span class="text-[13px] text-neutral-400 text-pretty">{p.body}</span>
        </div>
      ))}
    </div>
    <p class="mt-8 mb-0 text-[13px] text-neutral-400">{about.makersNote}</p>
  </LabelledSection>

  <StatsBand />
  <CtaPanel />
</BaseLayout>
